# Copy to .env for local runs (never commit .env). On Railway set these as Variables,
# on Azure as App Settings (optionally as Key Vault references).
COMTRADE_API_KEY=
FRED_API_KEY=
DESTATIS_TOKEN=
# or instead of the token:
# DESTATIS_USER=
# DESTATIS_PASSWORD=

# Optional: protect the tool with a username/password (HTTP basic auth).
APP_USERNAME=hva
APP_PASSWORD=
